# Copy this file to .env and adjust the values.

# Port the HTTP server listens on.
PORT=8080

# Postgres connection string.
DATABASE_URL=postgres://geotreasure:geotreasure@localhost:5432/geotreasure?sslmode=disable

# Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of origins allowed to call the API (your frontend URLs).
# Include your local dev URL and your Vercel deployment URL.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
